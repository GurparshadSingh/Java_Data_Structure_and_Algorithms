
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Comparator;

public class solution {
    public static void main(String[] args) {
        int start[] = { 1, 3, 0, 5, 8, 5 };
        int end[] = { 2, 4, 6, 7, 9, 9 };

        // agr end time basis pr sorted hoe he na toh sorting kaise krni
        int arr[][] = new int[start.length][3];
        for (int i = 0; i < start.length; i++) {
            arr[i][0] = i;
            arr[i][1] = start[i];
            arr[i][2] = end[i];
        }
        Arrays.sort(arr, Comparator.comparingDouble(o -> o[2]));

        // end time basis sorted
        int maxAct = 0;
        ArrayList<Integer> ans = new ArrayList<>();

        // 1st activity
        maxAct = 1;
        ans.add(arr[0][0]);
        int lastEnd = arr[0][2];
        for (int i = 1; i < end.length; i++) {
            // agli activity selection
            if (arr[i][1] >= lastEnd) {
                maxAct++;
                ans.add(arr[i][0]);
                lastEnd = arr[i][2];
            }
        }
        System.out.println("Max no. of activities that can be performed is :" + maxAct);
        for (int index = 0; index < ans.size(); index++) {
            System.out.println("The activities performed are :" + "A" + ans.get(index) + " ");

        }
    }
}
