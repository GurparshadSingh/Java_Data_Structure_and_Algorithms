
public class solution {

    public static int search(int arr[], int target) {
        int si = 0;
        int ei = arr.length - 1;
        while (si <= ei) {

            int mid = si + (ei - si) / 2;
            if (arr[mid] == target) {
                return mid;
            }
            if (target < arr[mid]) {
                ei = mid - 1;
            } else {
                si = mid + 1;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int arr[] = {2, 5, 8, 12, 16, 23, 38, 56, 72, 91};
        int target = 16;
        System.out.println(search(arr, target));
    }
}
