
class Solution {

    static class TrieNode {
        TrieNode[] child = new TrieNode[26];

        int bestIndex; // index of best word for this node
        int bestLen; // shortest length (tie-break rule)

        TrieNode() {
            bestIndex = -1;
            bestLen = Integer.MAX_VALUE;
        }
    }

    static class Trie {
        TrieNode root = new TrieNode();
        // insert reversed word

        void insert(String word, int idx) {
            TrieNode node = root;

            // update root (handles empty match case)
            update(node, word.length(), idx);

            for (int i = word.length() - 1; i >= 0; i--) {
                int c = word.charAt(i) - 'a';
                if (node.child[c] == null) {
                    node.child[c] = new TrieNode();
                }
                node = node.child[c];
                update(node, word.length(), idx);
            }
        }

        void update(TrieNode node, int len, int idx) {
            if (len < node.bestLen || (len == node.bestLen && idx < node.bestIndex)) {
                node.bestLen = len;
                node.bestIndex = idx;
            }
        }

        int query(String word) {
            TrieNode node = root;
            int ans = node.bestIndex;
            for (int i = word.length() - 1; i >= 0; i--) {
                int c = word.charAt(i) - 'a';

                if (node.child[c] == null)
                    break;

                node = node.child[c];
                ans = node.bestIndex;
            }
            return ans;
        }
    }

    public int[] stringIndices(String[] words, String[] queries) {

        Trie trie = new Trie();

        // build trie
        for (int i = 0; i < words.length; i++) {
            trie.insert(words[i], i);
        }

        // answer queries
        int[] res = new int[queries.length];

        for (int i = 0; i < queries.length; i++) {
            res[i] = trie.query(queries[i]);
        }

        return res;
    }
}
