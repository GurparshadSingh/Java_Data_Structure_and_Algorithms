
public class practice {

    public static int Rotated_search(int arr[], int target, int si, int ei) {
        int mid = si + (ei - si) / 2;
        if (si > ei) {
            return -1;
        }
        if (arr[mid] == target) {
            return mid;
        }

        // if mid on l1
        if (arr[si] <= arr[mid]) {
            if (arr[si] <= target && target <= arr[mid]) {
                return Rotated_search(arr, target, si, mid-1);
            } else {
                return Rotated_search(arr, target, mid + 1, ei);
            }
        } else {
            if (arr[mid] <= arr[ei]) {
                if (arr[mid] <= target && target <= arr[ei]) {
                    return Rotated_search(arr, target, mid + 1, ei);
                } else {
                    return Rotated_search(arr, target, si, mid - 1);
                }
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int arr[] = {4, 5, 6, 7, 0, 1, 2};
        int target = 0;
        Rotated_search(arr, target, 0, arr.length - 1);
    }
}
