
public class Binary_Strings {

    public static void Binary_Strings_nonConc1(int n, int lastPlace, String str) {
        if (n == 0) {
            System.out.println(str);
            return;
        }
        Binary_Strings_nonConc1(n - 1, 0, str+"0");
        if (lastPlace == 0) {
            Binary_Strings_nonConc1(n - 1, 1, str+"1");
        }
    }

    public static void main(String[] args) {
   Binary_Strings_nonConc1(3, 0, "");
    }
}
